					}
				]
			},
			"minecraft:wearable": {
				"dispensable": true,
				"protection": 2,
				"slot": "slot.armor.head"
			},
			"minecraft:durability": {
				"max_durability": 128
			},
			"minecraft:tags": {
				"tags": [
					"minecraft:is_armor",
					"minecraft:copper_tier"
				]
			}
		}
	}
