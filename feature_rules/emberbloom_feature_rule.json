{
	"format_version": "1.13.0",
	"minecraft:feature_rules": {
		"description": {
			"identifier": "ac:emberbloom_feature_rule",
			"places_feature": "ac:emberbloom_scatter_feature"
		},
		"conditions": {
			"placement_pass": "surface_pass",
			"minecraft:biome_filter": [
				{
					"any_of": [
						{
							"test": "has_biome_tag",
							"operator": "==",
							"value": "frozen"
						},
						{
							"test": "has_biome_tag",
							"operator": "==",
							"value": "cold"
						}
					]
				}
			]
		},
		"distribution": {
			"iterations": 1,
			"x": {
				"distribution": "uniform",
				"extent": [ 0, 16 ]
			},
			"y": {
				"distribution": "uniform",
        		"extent": [ 0, "query.heightmap(variable.worldx, variable.worldz) * 2" ]
			},
			"z": {
				"distribution": "uniform",
				"extent": [ 0, 16 ]
			}
		}
	}
}