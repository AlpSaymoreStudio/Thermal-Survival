{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "ts:biter",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "components": {
            "minecraft:type_family": { "family": ["biter", "monster", "mob"] },
            "minecraft:health": { "value": 16, "max": 16 },
            "minecraft:attack": { "damage": 3, "effect_name": "slowness", "effect_duration": 5 },
            "minecraft:movement": { "value": 0.4 },
            "minecraft:navigation.walk": { "can_path_over_water": false, "avoid_damage_blocks": true },
            "minecraft:movement.basic": {},
            "minecraft:jump.static": {},
            "minecraft:can_climb": {},
            "minecraft:collision_box": { "width": 0.8, "height": 0.9 },
            "minecraft:physics": {},
            "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
            "minecraft:damage_sensor": {
                "triggers": [
                    { "cause": "fire", "deals_damage": true, "damage_modifier": 2.0 },
                    { "cause": "fire_tick", "deals_damage": true, "damage_modifier": 2.0 }
                ]
            },
            "minecraft:loot": { "table": "loot_tables/entities/stray.json" },
            "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? 3 : 0" },
            "minecraft:behavior.hurt_by_target": { "priority": 1 },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 2,
                "reselect_targets": true,
                "entity_types": [{ "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 12 }]
            },
            "minecraft:behavior.melee_attack": { "priority": 3, "track_target": true, "speed_multiplier": 1.2 },
            "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 1.0 },
            "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 6.0 },
            "minecraft:behavior.random_look_around": { "priority": 9 }
        },
        "events": {}
    }
}
