{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "ts:frostologer",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "ts:low_frost": {
                "minecraft:variant": { "value": 1 }
            },
            "ts:medium_frost": {
                "minecraft:variant": { "value": 2 }
            },
            "ts:high_frost": {
                "minecraft:variant": { "value": 3 }
            }
        },
        "components": {
            "minecraft:type_family": { "family": ["frostologer", "illager", "monster", "mob"] },
            "minecraft:health": { "value": 60, "max": 60 },
            "minecraft:attack": { "damage": 8 },
            "minecraft:movement": { "value": 0.3 },
            "minecraft:navigation.walk": { "can_path_over_water": true, "avoid_damage_blocks": true },
            "minecraft:movement.basic": {},
            "minecraft:jump.static": {},
            "minecraft:can_climb": {},
            "minecraft:collision_box": { "width": 0.6, "height": 1.95 },
            "minecraft:physics": {},
            "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": true },
            "minecraft:damage_sensor": {
                "triggers": [
                    { "cause": "fire", "deals_damage": true, "damage_modifier": 2.5 },
                    { "cause": "fire_tick", "deals_damage": true, "damage_modifier": 2.5 }
                ]
            },
            "minecraft:loot": { "table": "loot_tables/entities/evoker.json" },
            "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? 50 : 0" },
            "minecraft:behavior.hurt_by_target": { "priority": 1 },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 2,
                "reselect_targets": true,
                "entity_types": [{ "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 24 }]
            },
            "minecraft:behavior.ranged_attack": {
                "priority": 3,
                "attack_interval_min": 2.0,
                "attack_interval_max": 4.0,
                "attack_radius": 15.0,
                "speed_multiplier": 1.0
            },
            "minecraft:shooter": {
                "def": "ts:frost_projectile"
            },
            "minecraft:behavior.move_towards_target": { "priority": 5, "speed_multiplier": 0.8 },
            "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 16.0 },
            "minecraft:behavior.random_look_around": { "priority": 9 },
            "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.8 }
        },
        "events": {
            "ts:enter_low_frost": {
                "add": { "component_groups": ["ts:low_frost"] },
                "remove": { "component_groups": ["ts:medium_frost", "ts:high_frost"] }
            },
            "ts:enter_medium_frost": {
                "add": { "component_groups": ["ts:medium_frost"] },
                "remove": { "component_groups": ["ts:low_frost", "ts:high_frost"] }
            },
            "ts:enter_high_frost": {
                "add": { "component_groups": ["ts:high_frost"] },
                "remove": { "component_groups": ["ts:low_frost", "ts:medium_frost"] }
            }
        }
    }
}
